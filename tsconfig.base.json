{
  
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@adversyn/*": ["packages/*/src/index.ts"] },  
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  }
}
